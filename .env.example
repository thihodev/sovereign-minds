# Sovereign Minds — copy this file to .env and fill in what you have.
# Every provider below has a FREE tier. A nation whose key is missing is
# played by a simple built-in bot until you add the key (FILL_WITH_BOTS=true).

# ---- World
WORLD_SEED=nguyen-dia-1
# One nation per provider, in this order (ids: gemini, mistral, nvidia, zai,
# openrouter, groq, sambanova, cohere, cloudflare, bot). Only used when a new
# world is created (empty data/world.db).
NATIONS=openrouter,cohere,cloudflare,groq,gemini,zai
FILL_WITH_BOTS=true
# Seconds between turns (can be changed live from the UI). 600 = 10 minutes.
TICK_SECONDS=600
AI_TIMEOUT_SEC=90

# ---- Free AI keys (never commit .env)
GEMINI_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
ZAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
SAMBANOVA_API_KEY=
COHERE_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Local models on your own machine (free, no quota): run Ollama, then
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1   (from Docker)
# OLLAMA_MODEL=qwen3:8b
# Any other OpenAI-compatible endpoint:
# CUSTOM_BASE_URL=   CUSTOM_API_KEY=   CUSTOM_MODEL=   CUSTOM_LABEL=
# Provider ids for NATIONS / JUDGE_PROVIDERS also include: ollama, custom

# Model ids change often; override any default here (see your console):
# GEMINI_MODEL=gemini-3.8-flash
# MISTRAL_MODEL=mistral-medium-latest
# NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
# ZAI_MODEL=glm-4.7-flash
# OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free   (Chinese, rednote; or nvidia/nemotron-3-super-120b-a12b:free)
# GROQ_MODEL=qwen/qwen3.8-27b
# SAMBANOVA_MODEL=MiniMax-M3   (the only model free without a payment method)
# COHERE_MODEL=command-a-03-2025
# CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# ---- Judge of inventions (§5.4). "claude" = Claude Sonnet 5.5 through the Claude
# account you log in with (Chat Claude tab); it is tried first. The free providers
# after it are the fallback when Claude is not logged in or is rate limited.
# The proposer's own provider is never used.
JUDGE_PROVIDERS=claude,groq,cohere,cloudflare,sambanova,gemini,zai,openrouter
# JUDGE_CLAUDE_MODEL=claude-sonnet-5-5
JUDGES_PER_TICK=3
# JUDGE_MODEL_GROQ=openai/gpt-oss-120b

# ---- Historian (§10.1): every HISTORIAN_EVERY ticks a neutral AI retells the
# chronicle as one chapter of history (Biên niên tab). HISTORIAN_PROVIDER is a
# provider id, "claude" (your Claude subscription, see below) or "off". Unset:
# the first provider with a key from groq,cohere,cloudflare,sambanova,mistral,
# gemini,openrouter,ollama,custom, preferring one that runs no nation.
HISTORIAN_PROVIDER=groq
HISTORIAN_EVERY=10
# HISTORIAN_MODEL=

# ---- Claude chat (uses your Claude subscription via Claude Code; no API cost)
CLAUDE_MODEL=sonnet
# Optional instead of logging in from the UI: a token from `claude setup-token`
# CLAUDE_CODE_OAUTH_TOKEN=

# ---- Server
PORT=3000
# Set a token if you ever expose the UI beyond this machine:
# WATCHER_TOKEN=
