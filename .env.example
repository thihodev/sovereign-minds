# Sovereign Minds — copy this file to .env.
# Every nation plays through the Claude account you log in with (Chat Claude tab,
# Pro/Max plan, no API cost). Pick each nation's trait, model and effort in the
# "Thế giới mới" dialog. The free-provider keys below are optional.

# ---- World
WORLD_SEED=nguyen-dia-1
# The nations of a brand-new install (empty data/world.db), before you open the
# "Thế giới mới" dialog: claude[:haiku|sonnet[:low|medium|high|xhigh|max]], or a
# free provider id (gemini, mistral, nvidia, zai, openrouter, groq, sambanova,
# cohere, cloudflare, ollama, custom) or bot. Traits are drawn from the seed.
NATIONS=claude,claude,claude,claude,claude,claude
FILL_WITH_BOTS=true
# Seconds between turns (can be changed live from the UI). 1200 = 20 minutes:
# every turn is one Claude run per nation, so slower turns save your plan limits.
TICK_SECONDS=1200
AI_TIMEOUT_SEC=90
# Claude runs at most this many `claude` processes at once (nations, judge, Historian).
CLAUDE_CONCURRENCY=2

# ---- Free AI keys, optional (never commit .env)
GEMINI_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
ZAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
SAMBANOVA_API_KEY=
COHERE_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Local models on your own machine (free, no quota): run Ollama, then
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1   (from Docker)
# OLLAMA_MODEL=qwen3:8b
# Any other OpenAI-compatible endpoint:
# CUSTOM_BASE_URL=   CUSTOM_API_KEY=   CUSTOM_MODEL=   CUSTOM_LABEL=
# Provider ids for NATIONS / JUDGE_PROVIDERS also include: ollama, custom

# Model ids change often; override any default here (see your console):
# GEMINI_MODEL=gemini-3.8-flash
# MISTRAL_MODEL=mistral-medium-latest
# NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
# ZAI_MODEL=glm-4.7-flash
# OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free   (Chinese, rednote; or nvidia/nemotron-3-super-120b-a12b:free)
# GROQ_MODEL=qwen/qwen3.8-27b
# SAMBANOVA_MODEL=MiniMax-M3   (the only model free without a payment method)
# COHERE_MODEL=command-a-03-2025
# CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# ---- Judge of inventions (§5.4). "claude" = Claude Sonnet 5.5 through the Claude
# account you log in with. Add free providers after it (claude,groq,…) as a
# fallback when Claude is not logged in or is rate limited; the proposer's own
# provider is never used. The Watcher can always judge by hand.
JUDGE_PROVIDERS=claude
# JUDGE_CLAUDE_MODEL=claude-sonnet-5-5
JUDGES_PER_TICK=3
# JUDGE_MODEL_GROQ=openai/gpt-oss-120b

# ---- Historian (§10.1): every HISTORIAN_EVERY ticks a neutral AI retells the
# chronicle as one chapter of history (Biên niên tab). HISTORIAN_PROVIDER is
# "claude" (the default: Haiku, effort low), "off", a provider id, or "auto" for
# the first free provider with a key, preferring one that runs no nation.
HISTORIAN_PROVIDER=claude
HISTORIAN_EVERY=10
# HISTORIAN_MODEL=   (with claude: haiku or sonnet)

# ---- Claude chat (uses your Claude subscription via Claude Code; no API cost)
CLAUDE_MODEL=sonnet
# Optional instead of logging in from the UI: a token from `claude setup-token`
# CLAUDE_CODE_OAUTH_TOKEN=

# ---- Server
PORT=3000
# Set a token if you ever expose the UI beyond this machine:
# WATCHER_TOKEN=
